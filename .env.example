# Configuração do Portal Fiscal. Copie para .env (na mesma pasta do app.py) e ajuste o que precisar.
# Variáveis definidas no ambiente (ou no iniciar-portal.bat) têm prioridade sobre este arquivo.
# O .env fica fora do git; nunca coloque senhas de lojas aqui.

# Interface e porta de escuta. 127.0.0.1 = só este computador. Para a rede interna use 0.0.0.0,
# mas só em rede confiável e seguindo o README (proxy com HTTPS, firewall).
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8000

# Pasta privada com o banco, o segredo local (.secret) e os SPED publicados. Padrão: data\ do projeto.
# PORTAL_DATA_DIR=D:\DadosProtegidos\PortalFiscal

# Pasta dos backups (python app.py backup e a tarefa agendada). Precisa ficar fora da pasta de dados;
# o ideal é outro disco. Padrão: backups\ do projeto.
# PORTAL_BACKUP_DIR=E:\Backups\PortalFiscal

# 1 = cookie de sessão só por HTTPS. Use somente com HTTPS configurado no proxy reverso.
COOKIE_SECURE=0

# Último mês (AAAA-MM) mostrado na previsão de publicação.
PORTAL_PREVISAO_ATE=2026-12

# 1 = reativa o monitoramento do suporte (desligado desde a 1.5).
PORTAL_MONITORAMENTO=0

# 1 = liga a fila de avisos de publicação, em modo de teste: nenhum e-mail sai do portal.
PORTAL_EMAIL=0

# Se preenchido, troca todo destinatário por estes endereços (separados por vírgula). Trava contra disparo acidental.
# PORTAL_EMAIL_REDIRECIONAR=voce@example.com

# 1 = os avisos saem de verdade pelo Resend. Exige PORTAL_EMAIL=1, RESEND_API_KEY e um destino seguro (veja o README).
PORTAL_EMAIL_ENVIO_REAL=0
# RESEND_API_KEY=
# PORTAL_EMAIL_REMETENTE=Portal Fiscal <avisos@example.com>
# 1 = o envio real vai aos contatos das lojas. Enquanto testa, use PORTAL_EMAIL_REDIRECIONAR.
PORTAL_EMAIL_PARA_LOJAS=0

# Endereço do link do aviso: o que pede o certificado digital. Vazio, o aviso sai sem link.
# PORTAL_URL_PUBLICA=https://certificado.example.com

# Segredo que o servidor HTTPS da frente manda em toda requisição, com pelo menos 32 caracteres aleatórios.
# Vazio, a entrada por certificado fica desligada. Veja o README antes de preencher.
# PORTAL_CERTIFICADO_SEGREDO=

# 1 = o portal só é alcançado por um proxy, e o endereço real de quem acessa vem no X-Forwarded-For.
PORTAL_ATRAS_DE_PROXY=0

# Caminho do Python usado pelos .bat (as tarefas do Windows gravam isto sozinhas ao instalar).
# PORTAL_PYTHON=C:\Python314\python.exe
